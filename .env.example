# Password del panel admin. Si se omite, el servidor genera uno seguro
# la primera vez y lo muestra una única vez en consola.
ADMIN_PASSWORD=

# Clave para firmar los tokens de sesión. Si se omite, el servidor genera
# una y la guarda en data/token.secret.
TOKEN_SECRET=

PORT=3000

# Dominio público del sitio (sin barra final). Se usa para las URLs absolutas
# de Open Graph, canónica y datos estructurados JSON-LD. Si se omite, se deriva
# del host de cada petición (correcto en local; en producción tras un proxy
# HTTPS conviene fijarlo, p. ej. BASE_URL=https://zanebarberstudio.com).
BASE_URL=

# Zona horaria del proceso. Afecta a la agrupación "hoy" de la cola de turnos
# y a los cierres de caja. Por defecto America/Caracas.
TZ=America/Caracas

# Solo detrás de un proxy inverso (nginx, Cloudflare…): número de saltos de
# proxy (normalmente 1), "loopback", o una lista de IPs. Sin proxy, déjalo vacío.
TRUST_PROXY=